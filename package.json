{
  "name": "grow-an-empire",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --open",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && vitest run",
    "package": "pnpm run build && node Tools/dev/package-bundle.mjs",
    "validate:bundle": "node Tools/dev/validate-bundle.mjs",
    "art:export": "python Tools/ArtPipeline/export_runtime_webp.py"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "3.2.7"
  }
}
