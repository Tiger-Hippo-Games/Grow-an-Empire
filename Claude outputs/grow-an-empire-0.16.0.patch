+#app .advisor-tip strong { display: block; margin: 2px 0; font-size: 1.12rem; color: #2a1608; }
+#app .advisor-tip p { margin: 0; font-size: .98rem; line-height: 1.4; }
+#app .advisor-tip button { flex: none; min-width: 44px; min-height: 44px; border: 0; border-radius: 10px; color: #6b4a2a; background: transparent; cursor: pointer; font-size: 1.1rem; }
+#app .cheer { position: absolute; z-index: 45; left: 50%; top: 38%; display: grid; justify-items: center; gap: 6px; min-width: min(520px, calc(100% - 32px)); padding: 22px 30px; text-align: center; transform: translate(-50%, -50%); border-radius: 22px; background: radial-gradient(ellipse at 50% 0%, #3a2a08, #1d1606); border: 3px solid #e0a526; box-shadow: 0 30px 80px #000b; pointer-events: none; animation: gae-pop .5s cubic-bezier(.2,1.5,.4,1) both; overflow: hidden; }
+#app .cheer.hidden { display: none; }
