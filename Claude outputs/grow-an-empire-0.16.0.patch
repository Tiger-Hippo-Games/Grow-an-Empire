+#app .cheer span { font-size: 1.12rem; color: #f4e9d3; }
+
+/* ---------- Motion ---------- */
+/* Pops animate the separate "scale" property, so each element keeps its own layout transform. */
+@keyframes gae-pop { from { opacity: 0; scale: .86; } to { opacity: 1; scale: 1; } }
+@keyframes gae-drop { from { opacity: 0; transform: translate(-50%, -14px); } to { opacity: 1; transform: translate(-50%, 0); } }
+@keyframes gae-slide { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
+@keyframes gae-pulse { 50% { transform: translate(-50%, 0) scale(1.08); } }
+@keyframes gae-breathe { 50% { box-shadow: inset 0 0 0 2px #f3cf6b, 0 0 0 6px #f3cf6b44, 0 8px 22px #0007; } }
+@keyframes gae-glow { 50% { box-shadow: 0 0 0 4px #f3cf6b, 0 0 24px 6px #f3cf6b88; } }
+@keyframes gae-star { from { opacity: 0; transform: scale(.2) rotate(-40deg); } 70% { opacity: 1; transform: scale(1.25) rotate(8deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
+@keyframes gae-confetti { 0% { opacity: 1; transform: translateY(0) rotate(0); } 100% { opacity: 0; transform: translateY(420px) rotate(calc(var(--i) * 97deg)); } }
+@media (prefers-reduced-motion: reduce) {
+  #app .tutorial-coach[data-step], #app .milestone[data-kind="built"].visible, #app .move-countdown, #app .move-countdown.urgent, #app .result-stars span.on, #app .badge-reveal, #app .badge-reveal li, #app .advisor-tip, #app .cheer, #app .badge-dialog, #app .fight-button, #app #tutorial-start, #app .tutorial-glow, #app .build-card.tutorial-pick { animation: none !important; }
+  #app .confetti { display: none; }
+}
+
+/* ---------- Phones and small frames ---------- */
+@container app (max-width: 700px) {
+  #app .tutorial-coach[data-step] { gap: 10px; padding: 12px 14px; }
+  #app .tutorial-coach > .advisor { width: 44px; height: 44px; }
+  #app .tutorial-coach > .coach-body > strong { font-size: 1.12rem; }
+  #app .tutorial-coach p { font-size: .95rem; }
+  #app .move-countdown { top: auto; bottom: calc(var(--build-panel-reach, 250px) + 12px); }
+  #app .tutorial-hero .advisor { width: 56px; height: 56px; }
+  #app .tutorial-dialog h2 { font-size: 1.6rem; }
+  #app .result-banner h2 { font-size: 2.2rem; }
+  #app .result-stars { font-size: 2.4rem; }
+  #app .verdict { gap: 10px; padding: 10px 12px; }
+  #app .verdict-stars { font-size: 1.5rem; }
+  #app .verdict-text strong { font-size: 1.25rem; }
+  #app .verdict-text small { font-size: .92rem; }
+  #app .flow-dialog .fight-button { min-width: 200px; min-height: 52px; font-size: 1.2rem; }
+  #app .milestone[data-kind="built"] { grid-template-columns: 60px minmax(0,1fr); }
+  #app .milestone[data-kind="built"]::before { width: 60px; height: 60px; }
+  #app .milestone[data-kind="built"] #milestone-title { font-size: 1.15rem; }
+  #app .move-report .ledger { grid-template-columns: minmax(0, 1fr); }
+  #app .campaign-badges-word { display: none; }
+  #app .cheer strong { font-size: 1.8rem; }
+  #app .advisor-tip { top: auto; bottom: calc(var(--build-panel-reach, 250px) + 12px); left: 12px; right: 12px; width: auto; }
+  #app .milestone[data-kind="built"] { left: 50%; transform: translateX(-50%); }
+  #app .tutorial-kicker, #app .tutorial-reassurance { display: none; }
+}
+
+/* Short landscape frames: coach and cards side by side (as before 0.16.0), lean welcome. */
+@container app (orientation: landscape) and (max-height: 540px) {
+  #app .tutorial-coach[data-step] { width: calc(42% - 24px); left: 12px; transform: none; gap: 10px; padding: 10px 12px; }
+  #app .tutorial-coach > .advisor { width: 40px; height: 40px; }
+  #app .tutorial-coach > .coach-body > strong { font-size: 1.08rem; }
+  #app .tutorial-coach p { font-size: .92rem; line-height: 1.4; }
+  #app .tutorial-kicker, #app .tutorial-reassurance { display: none; }
+  #app .tutorial-hero .advisor { width: 48px; height: 48px; }
+  #app .milestone[data-kind="built"] { left: 12px; transform: none; }
+}
