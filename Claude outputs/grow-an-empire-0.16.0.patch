+#app .medal.earned { filter: drop-shadow(0 4px 6px #0005); }
+#app .campaign-badges { position: absolute; z-index: 4; right: 20px; bottom: 192px; min-height: 44px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 16px 4px 10px; border: 0; border-radius: 999px; cursor: pointer; color: #fff4e0; font-weight: 800; background: linear-gradient(160deg, #6e2a14, #3a1408); box-shadow: inset 0 0 0 1px var(--haldi, #e0a526), 0 4px 14px #0007; }
+#app .campaign-badges b { font-family: var(--display); font-weight: 400; font-size: 20px; }
+#app .campaign-badges-medal { font-size: 20px; }
