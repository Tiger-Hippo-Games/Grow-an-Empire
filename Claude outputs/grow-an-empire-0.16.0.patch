+
+/* ---------- Advisor tips and celebrations ---------- */
+#app .advisor-tip { position: absolute; z-index: 30; right: 16px; top: calc(var(--hud-bottom, 64px) + 14px); display: flex; gap: 12px; align-items: flex-start; width: min(400px, calc(100% - 32px)); padding: 12px 14px; color: var(--parchment-ink); background: var(--parchment); border: 2px solid #c9952b; border-radius: 16px; box-shadow: 0 14px 36px #0008; animation: gae-slide .45s cubic-bezier(.2,1.3,.4,1) both; }
+#app .advisor-tip.hidden { display: none; }
